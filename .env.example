# =========================================================
# CONTOH VARIABEL LINGKUNGAN
# Salin file ini menjadi ".env" lalu isi nilainya.
# File ".env" TIDAK BOLEH diupload ke GitHub (sudah diabaikan .gitignore).
# =========================================================

# WAJIB UNTUK LOGIN — secret acak minimal 32 karakter
# Buat sekali: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# AUTH_SECRET=ganti-dengan-secret-acak-yang-panjang

# WAJIB — Connection string Pooled dari Neon (Dashboard Neon -> Connect -> Pooled)
# Contoh:
# DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# OPSIONAL — aktifkan jawaban AI berbasis model bahasa (cukup salah satu)
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# OPSIONAL — Web Push Notification Android/PWA
# Buat pasangan kunci SEKALI dengan: npx web-push generate-vapid-keys --json
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxx
# VAPID_PRIVATE_KEY=xxxxxxxxxxxxxxxxxxxx
# VAPID_SUBJECT=mailto:email-anda@example.com

# WAJIB UNTUK APK TWA TANPA ADDRESS BAR
# Ambil Package ID + SHA-256 dari hasil package PWABuilder / signing key.
# ANDROID_PACKAGE_NAME=com.namausaha.printflow
# Satu fingerprint:
# ANDROID_SHA256_CERT_FINGERPRINT=AA:BB:CC:DD:...:FF
# Jika direct APK + Google Play memakai sertifikat berbeda, masukkan keduanya dipisahkan koma:
# ANDROID_SHA256_CERT_FINGERPRINTS=AA:BB:...:FF,11:22:...:99

# OPSIONAL — kunci halaman /api/setup supaya hanya Anda yang bisa menjalankannya
# SETUP_TOKEN=kata-rahasia-anda
